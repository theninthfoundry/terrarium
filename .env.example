# Optional: enables evidence-grounded Gemma 4 analysis.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Keep public deployment in demo-only mode. To enable private repository analysis,
# set TERRARIUM_ALLOW_REPOSITORIES=1 and provide a long random API token.
TERRARIUM_ALLOW_REPOSITORIES=0
TERRARIUM_API_TOKEN=
TERRARIUM_WORKSPACE_ROOT=/var/www/terrarium
